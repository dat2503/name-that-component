{
  "manifest_version": 3,
  "name": "Name That Component",
  "version": "1.0.0",
  "description": "Identify UI elements by framework component, design system, ARIA role, and semantic label—entirely offline.",
  "minimum_chrome_version": "95",
  "homepage_url": "https://github.com/dat2503/name-that-component",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Name That Component (Alt+Shift+C)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting"],
  "commands": {
    "toggle-picker": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Toggle the component picker"
    }
  }
}
